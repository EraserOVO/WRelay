# ============================================================
# WRelay 运行配置模板
#
# 安装：双击 install.bat 后，若不存在 .env.prod 会自动复制本文件。
# 使用：打开桌面端配置向导，按用途填写账号；也可手动编辑配置。
# 注意：.env.prod 包含密钥，不要提交到 git，也不要外传。
#
# 每项详细说明见 docs/SETUP.md
# ============================================================

# 日志级别：DEBUG / INFO / WARNING / ERROR（DEBUG 日志量很大，排查时再用）
LOG_LEVEL=INFO

# NoneBot 驱动器组合。
# 默认驱动只有 ~fastapi（无 HTTP/WebSocket 客户端能力），QQ 适配器需要
# HTTP 客户端、Discord 适配器需要 Forward 连接，缺了启动会直接报错：
#   "Current driver ~fastapi does not support http client requests"
# 因此必须组合三者为完整驱动：
#   ~fastapi   = Web 服务（面板 /api 与 NoneBot 自身 ASGI）
#   ~httpx     = HTTP 客户端（plugins 的 httpx 与 Discord 消息抓取）
#   ~websockets= WebSocket 客户端（Discord/QQ 网关长连接）
DRIVER=~fastapi+~httpx+~websockets

# Bot 本地 HTTP 服务。管理面板通过该服务读取连接状态、消息追踪并执行补发；
# 必须保持 127.0.0.1:18082，避免暴露到局域网，也不要与面板的 18090 端口混用。
HOST=127.0.0.1
PORT=18082

# ------------------------------------------------------------
# Discord Bot
# 在 https://discord.com/developers/applications 创建应用，
# 在 Bot 页面获取 Token，并开启 Message Content Intent（特权网关意图）。
# 使用 Discord 时填自己的 Bot Token；其他用途可保留占位或填空列表。
# ------------------------------------------------------------
DISCORD_BOTS='[{"token": "在这里粘贴你的DiscordBotToken"}]'

# ------------------------------------------------------------
# QQ 官方机器人
# 在 https://q.qq.com 创建机器人，获取 AppID 与 AppSecret。
# 注意：id 与 token 都填 AppID（官方 Bot 以 AppID 作为 token），
# secret 填 AppSecret。
# ------------------------------------------------------------
QQ_BOTS='[{"id": "你的AppID", "token": "你的AppID", "secret": "你的AppSecret"}]'

# ------------------------------------------------------------
# 旧版 HTTP 代理变量（兼容保留）
# 当前程序清理代理环境变量，使用系统／虚拟网卡（TUN）路由。
# 此处留空，不通过本地 HTTP 代理端口配置出站连接。
# ------------------------------------------------------------
HTTP_PROXY=

# ------------------------------------------------------------
# 媒体下载参数（一般不需要改）
# API_TIMEOUT：单个媒体下载超时秒数
# MEDIA_CONCURRENCY：同时下载的媒体数量
# MEDIA_MAX_BYTES：单文件大小上限（字节），超过则放弃下载、降级为链接
# ------------------------------------------------------------
API_TIMEOUT=120
MEDIA_CONCURRENCY=4
MEDIA_MAX_BYTES=31457280

# ------------------------------------------------------------
# 可选：自动翻译服务密钥
# 管理面板只保存开关、模型和地址；所有密钥仅保留在 .env.prod。
# WRELAY_AI_API_KEY 用于 OpenAI 兼容的公告翻译服务（例如百炼、DeepSeek）。
# 腾讯 TMT 使用 TC3-HMAC-SHA256 签名；TextTranslate 可用性以腾讯云
# 当前账号和控制台为准，WRelay 调用失败会自动按配置降级。
# ------------------------------------------------------------
WRELAY_AI_API_KEY=
WRELAY_TENCENT_SECRET_ID=
WRELAY_TENCENT_SECRET_KEY=
